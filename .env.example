# Copy to .env and fill in locally:  cp .env.example .env
# NEVER commit .env (it is gitignored). Never paste real keys into chat.
ANTHROPIC_API_KEY=your-anthropic-key-here
# Optional override; default is claude-opus-5-5
# CANVAS_AGENT_MODEL=claude-opus-5-5

# Canvas LMS (read-only token from Account > Settings > New Access Token)
CANVAS_BASE_URL=https://your-school.instructure.com
CANVAS_TOKEN=your-canvas-token-here

# Notion (later milestone): internal integration token + target database id
NOTION_TOKEN=your-notion-token-here
NOTION_DATABASE_ID=your-database-id-here
