{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dashboard",
      "runtimeExecutable": ".venv/bin/streamlit",
      "runtimeArgs": [
        "run",
        "app.py",
        "--server.headless",
        "true",
        "--server.port",
        "8501"
      ],
      "port": 8501
    },
    {
      "name": "demo",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "COURSE_DATA_DIR=demo_data",
        ".venv/bin/streamlit",
        "run",
        "app.py",
        "--server.headless",
        "true",
        "--server.port",
        "8502"
      ],
      "port": 8502
    }
  ]
}
