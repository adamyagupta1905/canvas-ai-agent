{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dashboard",
      "runtimeExecutable": ".venv/bin/streamlit",
      "runtimeArgs": [
        "run",
        "app.py",
        "--server.headless",
        "true",
        "--server.port",
        "8501"
      ],
      "port": 8501
    },
    {
      "name": "demo",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "COURSE_DATA_DIR=demo_data",
        ".venv/bin/streamlit",
        "run",
        "app.py",
        "--server.headless",
        "true",
        "--server.port",
        "8502"
      ],
      "port": 8502
    },
    {
      "name": "orbit",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "-m",
        "scripts.serve_web",
        "--port",
        "8503"
      ],
      "port": 8503
    },
    {
      "name": "orbit-demo",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "COURSE_DATA_DIR=demo_data",
        ".venv/bin/python",
        "-m",
        "scripts.serve_web",
        "--port",
        "8504"
      ],
      "port": 8504
    }
  ]
}
